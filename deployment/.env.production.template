# OpsPilot production .env — fill in secrets, copy to /opt/opspilot/.env on the ECS server
# DO NOT commit this file with real values

APP_NAME=opspilot
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false

# Database — SQLite stored in Docker named volume
DATABASE_URL=sqlite:////data/opspilot.db

# Qwen Cloud
LLM_PROVIDER=qwen
QWEN_API_KEY=YOUR_QWEN_API_KEY_HERE
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_REASONING_MODEL=qwen3.7-plus

# Auth — set to true to require login on dashboard
ENABLE_AUTH=true
ENABLE_DASHBOARD_AUTH=true

# Webhook secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE
